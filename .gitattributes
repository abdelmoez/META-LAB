# The Postgres schema + its migrations are GENERATED by
# server/scripts/sync-postgres-schema.mjs, and tests/unit/postgres-schema-sync.test.js
# compares the generator's output (always LF) against the bytes on disk. On Windows a
# plain checkout materialises them with CRLF, so the drift test fails on a clean tree
# for a reason that has nothing to do with the schema. Pin these to LF so the
# generator and the working copy can agree.  (116.md validation)
server/prisma/postgres/*.prisma text eol=lf
server/prisma/postgres/migrations/**/*.sql text eol=lf
